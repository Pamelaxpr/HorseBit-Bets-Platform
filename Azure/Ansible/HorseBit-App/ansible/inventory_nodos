# inventory_nodos — Inventario de nodos web HorseBit
# Formato INI de Ansible
# Uso: ansible-playbook -i ansible/inventory_nodos playbooks/10_deploy_nodos_web.yml

[webservers]
hipodromo-a ansible_host=192.168.10.103
hipodromo-b ansible_host=192.168.10.102

[webservers:vars]
ansible_user=nodocentral
ansible_ssh_private_key_file=~/.ssh/id_rsa
ansible_ssh_common_args="-o StrictHostKeyChecking=no"
